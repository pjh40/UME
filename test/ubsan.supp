# Ume/test/ubsan.supp
#
#   UBSAN_OPTIONS=suppressions=<source dir>/test/ubsan.supp
#
# UBSan suppressions for a UME_SANITIZE build.  -fsanitize=integer includes
# checks for unsigned wraparound, which is well defined in C++ and is reported
# because it is so often a bug in index arithmetic (len - 1 on an empty
# range).  That is why the check stays on for UME's own code.  libstdc++'s
# headers wrap on purpose, and when they are instrumented with UME's flags
# those reports bury any real one, so they are suppressed by location: a
# report whose source location is in a libstdc++ bits/ header.  Overflow in
# UME's code that is passed on to the library (a size of n - 1 handed to a
# std::vector constructor) is reported in UME's file, not here.
#
# The constructs seen with g++ 16's headers:
#   bits/stl_uninitialized.h   __uninitialized_fill_n's "for (; __n--; ...)"
#                              loop counter, from the std::vector fill
#                              constructors
#   bits/random.h, random.tcc  std::mt19937 seeding, twist and max()
#   bits/uniform_int_dist.h    uniform_int_distribution's negation of an
#                              unsigned range
unsigned-integer-overflow:*/include/c++/*/bits/*
# bits/random.tcc: std::mt19937's tempering, "__z ^= (__z << __s) & __b" and
# the same with __t, which shift set bits out of an unsigned result_type.
# -fsanitize=unsigned-shift-base reports under the runtime's shift-base
# suppression type; there is no unsigned-shift-base type to name here.
shift-base:*/include/c++/*/bits/*
